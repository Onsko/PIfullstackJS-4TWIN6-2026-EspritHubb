/**
 * Jenkinsfile.ci.backO - Pipeline CI/CD pour Backend PIfullstackJS
 * Auteur: Ons
 * Description: Tests automatisés avec sécurité et performance
 */

pipeline {
    agent any
    
    environment {
        NODE_VERSION = '20.18.0'
        NPM_CACHE_DIR = "${WORKSPACE}/.npm"
    }
    
    options {
        timeout(time: 30, unit: 'MINUTES')
    }
    
    triggers {
        pollSCM('H/5 * * * *')
        githubPush()
    }
    
    stages {
        stage('Setup Environment') {
            steps {
                script {
                    echo "Setup Environment - Node.js ${NODE_VERSION}"
                    
                    cleanWs()
                    
                    sh """
                        node --version
                        npm --version
                        npm config set cache ${NPM_CACHE_DIR}
                        echo "NPM cache configuré: ${NPM_CACHE_DIR}"
                    """
                }
            }
        }
        
        stage('Declarative: Checkout SCM') {
            steps {
                checkout scm
            }
        }
        
        stage('Install Dependencies') {
            steps {
                dir('backend') {
                    script {
                        echo "Installation Backend Dependencies"
                                
                        sh """
                            npm install --prefer-offline --no-audit --progress=false
                            echo "Backend dependencies installées"
                        """
                    }
                }
            }
        }
        
        stage('Quality Checks') {
            parallel {
                stage('Lint Backend') {
                    steps {
                        dir('backend') {
                            script {
                                echo "Lint Backend Code"
                                
                                sh """
                                    npm run lint || true
                                    echo "Lint backend terminé"
                                """
                            }
                        }
                    }
                }
                
                stage('Type Check') {
                    steps {
                        dir('backend') {
                            script {
                                echo "TypeScript Type Check"
                                
                                sh """
                                    npx tsc --noEmit || true
                                    echo "Type check terminé"
                                """
                            }
                        }
                    }
                }
            }
        }
        
        stage('Test Suite') {
            parallel {
                stage('Backend Unit Tests') {
                    steps {
                        dir('backend') {
                            script {
                                echo "Backend Unit Tests"
                                
                                sh """
                                    npm run test:ci
                                    echo "Tests unitaires backend terminés"
                                """
                                
                                publishTestResults testResultsPattern: 'backend/test-results.xml'
                                publishHTML([
                                    allowMissing: false,
                                    alwaysLinkToLastBuild: true,
                                    keepAll: true,
                                    reportDir: 'backend/coverage',
                                    reportFiles: 'lcov-report/index.html',
                                    reportName: 'Backend Coverage Report'
                                ])
                            }
                        }
                    }
                }
                
                stage('Security Tests') {
                    steps {
                        dir('backend') {
                            script {
                                echo "Security Tests"
                                
                                sh """
                                    npm run test:security || true
                                    echo "Tests sécurité terminés"
                                """
                            }
                        }
                    }
                }
                
                stage('Performance Tests') {
                    steps {
                        dir('backend') {
                            script {
                                echo "Performance Tests"
                                
                                sh """
                                    npm run test:performance || true
                                    echo "Tests performance terminés"
                                """
                            }
                        }
                    }
                }
            }
        }
        
        stage('Build Backend') {
            steps {
                dir('backend') {
                    script {
                        echo "Build Backend"
                                
                        sh """
                            npm run build
                            echo "Build backend terminé"
                        """
                        
                        archiveArtifacts artifacts: 'backend/dist/**/*', fingerprint: true
                    }
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    script {
                        echo "SonarQube Analysis"
                        
                        sh """
                            npm run sonar:scan || echo "SonarQube scan terminé avec des warnings"
                        """
                        
                        echo "Analyse SonarQube terminée"
                    }
                }
            }
        }
        
        stage('Deploy - Staging') {
            when {
                anyOf {
                    branch 'main'
                    changeRequest()
                }
            }
            
            steps {
                script {
                    echo "Deploy to Staging"
                    
                    sh """
                        echo "Déploiement vers staging en cours..."
                        echo "Backend: ${BUILD_NUMBER}"
                        echo "Déploiement staging terminé"
                    """
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "Pipeline Results Summary"
                echo "Build Number: ${BUILD_NUMBER}"
                echo "Branch: ${env.BRANCH_NAME ?: 'unknown'}"
                echo "Commit: ${GIT_COMMIT}"
                
                sh """
                    npm cache clean --force
                    echo "NPM cache nettoyé"
                """
            }
        }
        
        success {
            script {
                echo "Pipeline SUCCESS - All tests passed!"
                
                sh """
                    echo "Notification: Pipeline ${BUILD_NUMBER} réussi"
                """
            }
        }
        
        failure {
            script {
                echo "Pipeline FAILED - Check logs"
                
                sh """
                    echo "Notification: Pipeline ${BUILD_NUMBER} échoué"
                    echo "Vérifier les logs pour plus de détails"
                """
            }
        }
        
        unstable {
            script {
                echo "Pipeline UNSTABLE - Some tests failed"
            }
        }
    }
}
